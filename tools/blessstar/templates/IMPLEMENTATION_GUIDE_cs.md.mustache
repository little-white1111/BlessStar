### 2.4 注册入口

生成文件：`Biz{{biz_id}}/ModuleInit.cs`

```csharp
using Blessstar.SDK.Config;
using Blessstar.SDK.Registry;

namespace Biz{{biz_id}};

public static class ModuleInit
{
    public static int Initialize(IntPtr adapterCtx)
    {
        NativeMethods.bs_config_declare(
            Fields.Declarations, Fields.Count
        );

        var manifest = new ManifestNative
        {
            BizId = "{{biz_id}}",
            DisplayName = "{{display_name}}",
            SdkVersion = "{{sdk_version}}"
        };
        NativeMethods.bs_biz_registry_register(ref manifest);

        return 0;
    }
}
```

