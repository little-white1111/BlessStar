package com.blessstar.biz.{{biz_id}};

import com.blessstar.sdk.config.*;
import com.blessstar.sdk.registry.*;

public class ModuleInit {
    public static int moduleInit(Object adapterCtx) {
        NativeBridge.bsConfigDeclare(Fields.FIELDS);
        
        Manifest manifest = new Manifest();
        manifest.setBizId("{{biz_id}}");
        manifest.setDisplayName("{{display_name}}");
        manifest.setSdkVersion("{{sdk_version}}");
        NativeBridge.bsBizRegistryRegister(manifest);
        
        return 0;
    }
}
```

