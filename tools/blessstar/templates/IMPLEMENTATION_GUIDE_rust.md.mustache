### 2.4 注册入口

生成文件：`biz_{{biz_id}}/src/lib.rs`

```rust
#![no_std]
extern crate alloc;

mod fields;
mod gates;
mod effects;

use core::ffi::CStr;

#[no_mangle]
pub extern "C" fn {{biz_id_underscore}}_module_init(adapter_ctx: *mut c_void) -> c_int {
    unsafe {
        bs_config_declare(
            fields::FIELDS.as_ptr() as *const FieldDecl,
            fields::FIELDS_COUNT,
        );

        let manifest = Manifest {
            biz_id: c"{{biz_id}}".as_ptr(),
            display_name: c"{{display_name}}".as_ptr(),
            sdk_version: c"{{sdk_version}}".as_ptr(),
        };
        bs_biz_registry_register(&manifest as *const Manifest);
    }
    0
}
```

