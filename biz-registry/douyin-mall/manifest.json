        "toolChain": ["read_config_value", "write_config_value"],
        "priority": 20
      }
    ],
    "dependency_hints": {
      "order.status.values": "依赖 payment.record_status.values（支付状态影响订单状态流转）和 product.status.values（商品下架影响已售订单）",
      "payment.record_status.values": "依赖 payment.type.values（不同支付方式的状态机一致）和 order.status.values（支付成功/失败驱动订单状态变化）",
      "user.registration.default_role": "必须存在于 user.role.values 枚举中，建议始终为最低权限角色",
      "user.registration.default_status": "必须存在于 user.status.values 枚举中",
      "user.validation.username_min_length": "与 username_max_length 配合使用形成范围约束",
      "user.validation.username_max_length": "不应超过数据库字段 varchar(50) 长度限制",
      "user.validation.password_min_length": "与 password_max_length 配合使用形成范围约束",
      "user.validation.password_max_length": "不应超过bcrypt算法72字节输入上限",
      "review.rating.min": "与 review.rating.max 配合，由数据库 CHECK 约束保障，变更需执行DDL",
      "review.rating.max": "变更评分上限（如改为10分制）是重大产品变更，需全链路改造"
    },
    "security_notes": [
      "JWT Secret Key 不应纳入配置管理，应通过环境变量或密钥管理系统注入",
      "cors.allowed_origins 生产环境禁止使用通配符*，需配置具体前端域名",
      "user.registration.default_role 应始终保持为最低权限角色（user）",
      "auth.password.bcrypt_cost 建议生产环境设为10~12，过高会影响登录性能",
      "所有枚举值变更需评估对上下游系统的影响，尤其是订单和支付状态枚举"
    ]
  }
}
