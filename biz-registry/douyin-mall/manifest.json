    "skillRoutes": [
      {
        "prefix": "douyin-mall",
        "description": "抖音商城综合配置管理：认证、用户、订单、支付、商品、评价等全领域配置的读取与修改",
        "toolChain": ["read_config_value", "write_config_value", "validate_value"],
        "priority": 10
      },
      {
        "prefix": "douyin-mall-auth",
        "description": "抖音商城认证鉴权域：JWT过期时间、密码加密强度等安全相关配置",
        "toolChain": ["read_config_value", "write_config_value"],
        "priority": 20
      },
      {
